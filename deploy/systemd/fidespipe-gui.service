[Unit]
Description=Fidespipe — веб-консоль (раны, журнал, DAG, редактор плагинов)
Documentation=https://github.com/wykserdex/fidespipe
After=network-online.target fidespipe.service
Wants=network-online.target

[Service]
Type=simple
User=fidespipe
Group=fidespipe

Environment=FIDESPIPE_TRUST_CONFIG=/etc/fidespipe/fidespipe-trust.yaml

# Слушаем только петлю: внешний доступ включается оператором осознанно, через
# --allow-remote и --public-host, и тогда же включается сессия. Ниже
# commented-out вариант для внешнего доступа.
ExecStart=/usr/local/bin/fidespipe gui \
    --listen 127.0.0.1:8765 \
    --plugins=/var/lib/fidespipe/plugins \
    --pipelines=/var/lib/fidespipe/pipelines \
    --runs-dir=/var/lib/fidespipe/var/runs

# Внешний доступ (открывать только вместе с прокси и сессией):
#   --listen 0.0.0.0:8765 --allow-remote --public-host=имя[:порт] --trusted-proxy

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/fidespipe
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# Одноразовый код входа печатается сюда: journalctl -u fidespipe-gui. Обменять
# его на cookie — вход в консоль.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fidespipe-gui

[Install]
WantedBy=multi-user.target
